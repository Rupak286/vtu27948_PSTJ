class Solution {
public boolean halvesAreAlike(String s) {


    String vowels = "aeiouAEIOU";
    int count = 0;
    int mid = s.length() / 2;

    for (int i = 0; i < s.length(); i++) {

        if (vowels.indexOf(s.charAt(i)) != -1) {

            if (i < mid) {
                count++;   // Vowel in first half
            } else {
                count--;   // Vowel in second half
            }
        }
    }

    return count == 0;
}

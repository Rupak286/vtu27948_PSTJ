import java.util.*;

class Codechef {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int T = sc.nextInt();

        while (T-- > 0) {
            String s = sc.next();

            int n = s.length();
            int mid = n / 2;

            int[] freq = new int[26];

            // Count characters in first half
            for (int i = 0; i < mid; i++) {
                freq[s.charAt(i) - 'a']++;
            }

            // For odd length, skip the middle character
            int start = (n % 2 == 0) ? mid : mid + 1;

            // Remove characters of second half
            for (int i = start; i < n; i++) {
                freq[s.charAt(i) - 'a']--;
            }

            boolean isLapindrome = true;

            for (int i = 0; i < 26; i++) {
                if (freq[i] != 0) {
                    isLapindrome = false;
                    break;
                }
            }

            if (isLapindrome) {
                System.out.println("YES");
            } else {
                System.out.println("NO");
            }
        }

        sc.close();
    }
}
